{
  "name": "crastur",
  "version": "3.3.0",
  "description": "Sistema de Ventas y Bot de WhatsApp para Crastur",
  "scripts": {
    "start": "tsx server/server.ts",
    "launch": "node launcher.js",
    "instalar": "node installer/server.js",
    "build": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "clean": "tsx scripts/clean_data.ts",
    "reset": "tsx scripts/reset_clean_install.ts",
    "catalogo-demo": "tsx scripts/cargar_catalogo_demo.ts",
    "actualizar": "tsx scripts/actualizar.ts",
    "preparar-entrega": "tsx scripts/preparar_entrega.ts",
    "migrar": "tsx scripts/migrar_catalogo_asesores.ts",
    "stop": "node -e \"const http=require('http'); const req=http.request('http://127.0.0.1:3333/api/system/shutdown', {method:'POST'}); req.on('error',()=>{}); req.end(); console.log('Solicitud de apagado enviada.');\"",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "node scripts/run_stress_and_edge_tests_isolated.js",
    "test:copy": "node scripts/run_copy_budget_tests_isolated.js",
    "test:ui": "tsx scripts/run_ui_e2e_tests.ts"
  },
  "keywords": [
    "crastur",
    "whatsapp",
    "bcv",
    "cashea"
  ],
  "author": "Crastur",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.16.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2"
  }
}
