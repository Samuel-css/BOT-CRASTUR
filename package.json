{
  "name": "crastur",
  "version": "1.0.0",
  "description": "Sistema de Ventas y Bot de WhatsApp para Crastur",
  "scripts": {
    "start": "node server/server.js",
    "launch": "node launcher.js",
    "build": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "maintenance": "node scripts/maintenance.js",
    "clean": "node scripts/clean_data.js",
    "reset": "node scripts/reset_clean_install.js",
    "stop": "node -e \"const http=require('http'); const req=http.request('http://localhost:3333/api/system/shutdown', {method:'POST'}); req.on('error',()=>{}); req.end(); console.log('Solicitud de apagado enviada.');\"",
    "test": "node scripts/run_stress_and_edge_tests.js",
    "test:catalog": "node scripts/test_catalog_pdf.js"
  },
  "keywords": [
    "crastur",
    "whatsapp",
    "bcv",
    "cashea"
  ],
  "author": "Crastur",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.2",
    "ws": "^8.21.3"
  }
}
