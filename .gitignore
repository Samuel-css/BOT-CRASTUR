# Dependencias
node_modules/
client/node_modules/

# Builds del servidor (se generan con npm run build:server; el cliente usa client/dist/)
/dist/

# Build del panel web: SÍ se versiona (lo sirve el servidor y lo empaqueta el instalador)


# SEGURIDAD CRÍTICA: Credenciales de WhatsApp (Baileys)
data/auth_info_baileys/
auth_info_baileys/
*.session

# Base de datos local y copias de seguridad (para no subir datos de clientes)
data/*.db
data/*.db-journal
data/backups/*.db
data/backups/*.json
data/catalogs/*.pdf
!data/catalogs/.gitkeep

# Mantener carpetas de datos
!data/.gitkeep
!data/backups/.gitkeep

# Logs y depuración
logs/
data/launcher.log
*.log
npm-debug.log*
yarn-debug.log*

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Archivos del sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Archivos temporales de pruebas
tmp/
*.tmp
