# Dependencias
node_modules/
client/node_modules/
package-lock.json

# Builds de producción
/dist/
!client/dist/


# SEGURIDAD CRÍTICA: Credenciales de WhatsApp (Baileys)
data/auth_info_baileys/
auth_info_baileys/
*.session

# Base de datos local y copias de seguridad (para no subir datos de clientes)
data/*.db
data/*.db-journal
data/backups/*.db
data/*.log
*.db

# Mantener carpetas de datos
!data/.gitkeep
!data/backups/.gitkeep

# Logs y depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Variables de entorno y secretos
.env
.env.local
.env.*.local

# Archivos del sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Archivos temporales de pruebas
tmp/
*.tmp
